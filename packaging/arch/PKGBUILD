# The command line interface of the wallpaper engine.
#
# The engine renders with wgpu, so a Vulkan (or GL) driver is needed at
# runtime; it is not a package dependency here, because the driver comes
# with the system (mesa, the proprietary nvidia driver, …).
#
# The graphical interface is a separate package:
# linux-wallpaper-engine-gui-git.
pkgname=linux-wallpaper-engine-git
pkgver=0.0.0
pkgrel=1
pkgdesc="Yet another linux wallpaper engine"
arch=("x86_64")
url="https://github.com/wqLouis/linux-wallpaperengine"
license=("GPL-3.0")
depends=()
makedepends=("git" "rustup")
# The graphical interface is optional: the command line interface does not
# need it.
optdepends=("linux-wallpaper-engine-gui-git: the graphical interface (the tray app)")
provides=("lwe-cli")
conflicts=("lwe-cli")
source=("${pkgname}::git+https://github.com/wqLouis/linux-wallpaperengine.git")
sha256sums=("SKIP")
options=(!strip)

pkgver() {
  cd "$srcdir/$pkgname"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$srcdir/$pkgname"
  rustup default stable
  git submodule update --init --recursive
}

build() {
  cd "$srcdir/$pkgname"
  cargo build --release -p linux-wallpaper-engine-cli
}

package() {
  cd "$srcdir/$pkgname"
  install -Dm0755 "target/release/lwe-cli" "${pkgdir}/usr/bin/lwe-cli"
}
